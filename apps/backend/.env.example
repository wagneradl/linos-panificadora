# ==================================
# AMBIENTE
# ==================================
# Valores aceitos: development, production, test
NODE_ENV="development"

# ==================================
# SERVIDOR
# ==================================
# Porta onde o backend será executado
PORT="3000"

# ==================================
# DATABASE
# ==================================
# Para desenvolvimento local, use: file:./dev.db
# Para produção (Render/Docker), use: file:/var/data/linos-padaria.db
DATABASE_URL="file:./dev.db"

# ==================================
# JWT (JSON Web Tokens)
# ==================================
# IMPORTANTE: Em produção, use secrets fortes e aleatórios!
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Secret para access tokens (obrigatório em produção)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Tempo de expiração do access token (exemplos: 15m, 1h, 1d)
JWT_EXPIRES_IN="15m"

# Secret para refresh tokens (obrigatório em produção)
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"

# Tempo de expiração do refresh token (exemplos: 7d, 30d)
JWT_REFRESH_EXPIRES_IN="7d"

# ==================================
# PDF STORAGE
# ==================================
# Caminho onde os PDFs gerados serão armazenados
# Para desenvolvimento: ./pdfs
# Para produção: /var/data/pdfs
PDF_STORAGE_PATH="./pdfs"

# ==================================
# ADMIN SEED (Primeiro Usuário)
# ==================================
# Essas variáveis são usadas para criar o usuário administrador inicial
# Se não fornecidas, o sistema funcionará normalmente mas não criará o admin automaticamente

# E-mail do administrador
ADMIN_EMAIL="admin@linospanificadora.com"

# Senha do administrador (mínimo 6 caracteres)
ADMIN_PASSWORD="admin123"

# Nome completo do administrador
ADMIN_FULL_NAME="Administrador do Sistema"

# ==================================
# CORS (Cross-Origin Resource Sharing)
# ==================================
# Habilitar/desabilitar CORS
CORS_ENABLED="true"

# Origem permitida (* permite todas, ou especifique: http://localhost:3001)
CORS_ORIGIN="*"
