# ==================================
# AMBIENTE
# ==================================
NODE_ENV="development"

# ==================================
# SERVIDOR
# ==================================
PORT="3000"

# ==================================
# DATABASE
# ==================================
DATABASE_URL="file:./dev.db"

# ==================================
# JWT (JSON Web Tokens)
# ==================================
JWT_SECRET="dev-secret-jwt-key-not-for-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-secret-refresh-key-not-for-production"
JWT_REFRESH_EXPIRES_IN="7d"

# ==================================
# PDF STORAGE
# ==================================
PDF_STORAGE_PATH="./pdfs"

# ==================================
# ADMIN SEED (Primeiro Usuário)
# ==================================
ADMIN_EMAIL="admin@linospanificadora.com"
ADMIN_PASSWORD="admin123"
ADMIN_FULL_NAME="Administrador do Sistema"

# ==================================
# CORS
# ==================================
CORS_ENABLED="true"
CORS_ORIGIN="*"
